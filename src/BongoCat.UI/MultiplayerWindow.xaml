<Window x:Class="BongoCat.UI.MultiplayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咚咚窝 · 多人联机"
        Width="380" Height="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}"
        ResizeMode="NoResize">

    <!--
      多人联机窗口（E8，普通窗口：非置顶可关闭，风格与背包/通行证一致走主题键）。
      code-behind 直连 MultiplayerCoordinator（联机是低频配置动作，状态简单；
      不为两三个输入框建 VM——与 TutorialBubbleWindow 同度的简化决策）。
    -->

    <StackPanel Margin="16">
        <TextBlock Text="云中继多人" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
        <TextBlock Text="和朋友把各自的猫摆到同一张桌面：在云服务器上跑中继，凭 6 位房间码跨互联网加入。"
                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}"
                   Margin="0,0,0,12"/>

        <TextBlock Text="中继服务器地址" FontSize="12" Foreground="{DynamicResource Text.Primary}"/>
        <TextBox x:Name="ServerBox" Margin="0,4,0,8" Padding="6,4"
                 ToolTip="云服务器 IP 或域名，可带端口（默认 9527）"/>

        <TextBlock Text="显示名" FontSize="12" Foreground="{DynamicResource Text.Primary}"/>
        <TextBox x:Name="NameBox" MaxLength="16" Margin="0,4,0,8" Padding="6,4"/>

        <TextBlock Text="房间码（创建房间留空）" FontSize="12" Foreground="{DynamicResource Text.Primary}"/>
        <TextBox x:Name="RoomCodeBox" MaxLength="6" Margin="0,4,0,12" Padding="6,4"
                 CharacterCasing="Upper" ToolTip="6 位无歧义字符（不含 0/O/1/I/L）"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="JoinButton" Grid.Column="0" Content="加入房间" Padding="0,8"
                    Background="{DynamicResource Button.AccentBg}"
                    BorderBrush="{DynamicResource Button.AccentBorder}"
                    Foreground="{DynamicResource Text.Primary}"
                    Click="OnJoinClick"/>
            <Button x:Name="LeaveButton" Grid.Column="2" Content="离开房间" Padding="0,8" IsEnabled="False"
                    Background="{DynamicResource Button.AccentBg}"
                    BorderBrush="{DynamicResource Button.AccentBorder}"
                    Foreground="{DynamicResource Text.Primary}"
                    Click="OnLeaveClick"/>
        </Grid>

        <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource Bg.Card}">
            <StackPanel>
                <TextBlock x:Name="StateText" Text="未连接" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}"/>
                <TextBlock x:Name="RoomCodeText" Text="" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Text.Primary}" Margin="0,2"/>
                <TextBlock Text="↑ 把房间码告诉朋友即可加入" FontSize="10"
                           Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="房间成员" FontSize="12" Foreground="{DynamicResource Text.Primary}" Margin="0,12,0,4"/>
        <ListBox x:Name="MemberList" Height="120" FontSize="12"
                 Background="{DynamicResource Bg.Card}" Foreground="{DynamicResource Text.Primary}"/>
    </StackPanel>
</Window>
