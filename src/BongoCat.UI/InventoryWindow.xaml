<Window x:Class="BongoCat.UI.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BongoCat.UI.ViewModels"
        xmlns:conv="clr-namespace:BongoCat.UI.Converters"
        Title="咚咚窝 · 背包图鉴"
        Width="600" Height="400"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}"
        ResizeMode="NoResize">

    <!--
      E3 背包/图鉴窗口（普通窗口：非置顶、可关闭，与桌宠窗口互不影响）。
      风格：E7 起全部走主题键 DynamicResource（App.Theming.UiThemeKeys）——
      默认奶油 = 奶油底 + 深棕文字 + 黏土粉按钮；托盘"主题"切换合并字典即时生效。
      品质色仍由 QualityToBrushConverter/HexToBrushConverter 提供（收集品语义色，不随主题变化）。
      图标：CosmeticIconConverter → CosmeticArt 同源 XAML Geometry（无位图素材）。
      MVVM：状态在 InventoryViewModel；本 code-behind 仅构造函数装配 DataContext。
    -->

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:QualityToBrushConverter x:Key="QualityBrush"/>
        <conv:CosmeticIconConverter x:Key="ItemIcon"/>
        <conv:EquipBorderConverter x:Key="EquipBorder"/>

        <!-- 背包物品卡（品质点 + 图标 + 名称 + 数量角标 + 已装备高亮） -->
        <DataTemplate x:Key="BackpackCardTemplate">
            <Border Width="104" Margin="4" Padding="6" CornerRadius="10"
                    Background="{DynamicResource Bg.Card}" BorderThickness="2">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource EquipBorder}">
                        <Binding Path="IsEquipped"/>
                        <Binding Path="QualityHex"/>
                    </MultiBinding>
                </Border.BorderBrush>
                <StackPanel>
                    <Grid>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Left"
                                 Fill="{Binding QualityHex, Converter={StaticResource HexToBrush}}"/>
                        <TextBlock Text="{Binding Count, StringFormat=x{0}}" FontSize="11"
                                   Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ContentControl Width="48" Height="48" Margin="0,2"
                                    HorizontalAlignment="Center"
                                    Content="{Binding Converter={StaticResource ItemIcon}}"/>
                    <TextBlock Text="{Binding Item.DisplayName}" FontSize="12"
                               Foreground="{DynamicResource Text.Primary}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="已装备" FontSize="10" TextAlignment="Center"
                               Foreground="{Binding QualityHex, Converter={StaticResource HexToBrush}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEquipped}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 图鉴卡（已拥有彩色 + 名称；未拥有灰剪影 + ？？？ + 未获得，GDD-03 §7） -->
        <DataTemplate x:Key="DexCardTemplate">
            <Border Width="104" Margin="4" Padding="6" CornerRadius="10"
                    Background="{DynamicResource Bg.Card}" BorderThickness="2" BorderBrush="{DynamicResource Border.Card}">
                <StackPanel>
                    <Grid>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Left"
                                 Fill="{Binding Item.Quality, Converter={StaticResource QualityBrush}}"/>
                        <TextBlock Text="{Binding OwnedText}" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Text.Primary}"/>
                    </Grid>
                    <ContentControl Width="48" Height="48" Margin="0,2" HorizontalAlignment="Center"
                                    Content="{Binding Converter={StaticResource ItemIcon}}"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                               Foreground="{DynamicResource Text.Primary}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- E4：开箱/掉落结果 chip（品质色点 + 名称 + 重复/新物品角标） -->
        <DataTemplate x:Key="ResultChipTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{Binding QualityHex, Converter={StaticResource HexToBrush}}"/>
                <TextBlock Text="{Binding DisplayName}" FontSize="12" Margin="5,0,0,0"
                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Badge}" FontSize="11" Margin="4,0,0,0"
                           Foreground="{Binding QualityHex, Converter={StaticResource HexToBrush}}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <TabControl Margin="8" Background="Transparent" BorderBrush="{DynamicResource Text.Primary}">

        <!-- ═══ Tab 1：背包 ═══ -->
        <TabItem Header="背包" Foreground="{DynamicResource Text.Primary}">
            <DockPanel Margin="4">
                <!-- 顶栏（E4）：金币 + 掉落倒计时 + 开宝箱（充能倒计时）+ 最近掉落/开箱结果 -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,6" CornerRadius="10"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="2">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <!-- 金币色点（琥珀金，GDD-02 §6.1 经济主色调）+ E5 变化闪动反馈 -->
                                <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{DynamicResource Accent.Amber}"/>
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"
                                           FontWeight="Bold" Text="{Binding CoinsText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CoinsFlash}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.Amber}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBlock Text="{Binding DropCountdownText}" FontSize="12"
                                           Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="{Binding ChestButtonText}" Width="110" Padding="0,4"
                                        Command="{Binding OpenChestCommand}" Background="{DynamicResource Button.AccentBg}"
                                        BorderBrush="{DynamicResource Button.AccentBorder}" Foreground="{DynamicResource Text.Primary}"/>
                                <!-- E6：通行证快捷入口（回调路由托盘命令，App 层开窗） -->
                                <Button Content="通行证" Width="64" Padding="0,4" Margin="6,0,0,0" FontSize="12"
                                        Click="OnOpenPassClick" Background="{DynamicResource Bg.Card}"
                                        BorderBrush="{DynamicResource Border.Card}" Foreground="{DynamicResource Text.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastEventText}" FontSize="12" Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center" Margin="16,0,16,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ResultChips}" Margin="0,4,0,0"
                                      ItemTemplate="{StaticResource ResultChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 左栏：槽位过滤 -->
                <Border DockPanel.Dock="Left" Width="92" Margin="0,0,8,0" CornerRadius="10"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="2">
                    <StackPanel Margin="10,12">
                        <TextBlock Text="槽位" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8"/>
                        <RadioButton Content="全部" Margin="0,3" Foreground="{DynamicResource Text.Primary}" GroupName="slot"
                                     IsChecked="{Binding FilterAll, Mode=TwoWay}"/>
                        <RadioButton Content="帽子" Margin="0,3" Foreground="{DynamicResource Text.Primary}" GroupName="slot"
                                     IsChecked="{Binding FilterHat, Mode=TwoWay}"/>
                        <RadioButton Content="皮肤" Margin="0,3" Foreground="{DynamicResource Text.Primary}" GroupName="slot"
                                     IsChecked="{Binding FilterSkin, Mode=TwoWay}"/>
                        <RadioButton Content="鼓" Margin="0,3" Foreground="{DynamicResource Text.Primary}" GroupName="slot"
                                     IsChecked="{Binding FilterBongos, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- 底栏：选中信息 + 合成/拆解（E5，灰置带 tooltip）+ 装备/卸下 -->
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" CornerRadius="10"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="2">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                                     Fill="{Binding SelectedCard.QualityHex, Converter={StaticResource HexToBrush}, FallbackValue=Transparent}"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.Primary}"
                                       Text="{Binding SelectedCard.Item.DisplayName, TargetNullValue=点选一件物品}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="合成" Width="60" Margin="0,0,6,0" Padding="0,4" FontSize="12"
                                    Command="{Binding SynthesizeCommand}"
                                    ToolTip="{Binding SynthesizeTooltip}"
                                    Background="{DynamicResource Button.AccentBg}" BorderBrush="{DynamicResource Button.AccentBorder}" Foreground="{DynamicResource Text.Primary}"/>
                            <Button Content="{Binding SalvageButtonText}" Width="76" Margin="0,0,6,0" Padding="0,4" FontSize="12"
                                    Command="{Binding SalvageCommand}"
                                    ToolTip="{Binding SalvageTooltip}"
                                    Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" Foreground="{DynamicResource Text.Primary}"/>
                            <Button Content="装备" Width="60" Margin="0,0,6,0" Padding="0,4" FontSize="12"
                                    Command="{Binding EquipCommand}" Background="{DynamicResource Button.AccentBg}" BorderBrush="{DynamicResource Button.AccentBorder}" Foreground="{DynamicResource Text.Primary}"/>
                            <Button Content="卸下" Width="60" Padding="0,4" FontSize="12"
                                    Command="{Binding UnequipCommand}" Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 物品网格 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Cards}"
                             SelectedItem="{Binding SelectedCard}"
                             ItemTemplate="{StaticResource BackpackCardTemplate}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ═══ Tab 2：图鉴 ═══ -->
        <TabItem Header="图鉴" Foreground="{DynamicResource Text.Primary}">
            <DockPanel Margin="4">
                <TextBlock DockPanel.Dock="Top" Margin="2,0,0,8" FontSize="13" Foreground="{DynamicResource Text.Primary}">
                    <Run Text="收集进度："/>
                    <Run Text="{Binding DexOwnedCount, Mode=OneWay}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding DexTotalCount, Mode=OneWay}"/>
                </TextBlock>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding DexEntries}"
                             ItemTemplate="{StaticResource DexCardTemplate}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </TabItem>
        <!-- ═══ Tab 3：商店 · 预设（E5）═══ -->
        <TabItem Header="商店 · 预设" Foreground="{DynamicResource Text.Primary}">
            <DockPanel Margin="4">

                <!-- 商店区：金币买箱（三档，economy.json chests 数据驱动；立即获得充能可开） -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="10"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="宝箱商店（购买后立即开出）" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding ChestShopCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Margin="0,0,10,0" Padding="8,6" CornerRadius="10"
                                            Background="{DynamicResource Bg.Window}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text.Primary}" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0} 金币}" FontSize="12"
                                                       Foreground="{DynamicResource Accent.Amber}" TextAlignment="Center" Margin="0,2"/>
                                            <Button Content="购买" Width="120" Padding="0,4" Margin="0,4,0,0"
                                                    Command="{Binding DataContext.BuyChestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding ChestId}"
                                                    ToolTip="{Binding Price, StringFormat=需要 {0} 金币}"
                                                    Background="{DynamicResource Button.AccentBg}" BorderBrush="{DynamicResource Button.AccentBorder}" Foreground="{DynamicResource Text.Primary}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 预设区：三槽整套装扮存/取/切换/删除 -->
                <Border Padding="10,8" CornerRadius="10"
                        Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" BorderThickness="2"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="装扮预设" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="选择" FontSize="12" Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="130" Margin="0,0,8,0"
                                      ItemsSource="{Binding PresetNames}"
                                      SelectedItem="{Binding SelectedPreset}"/>
                            <Button Content="应用" Width="64" Margin="0,0,6,0" Padding="0,4"
                                    Command="{Binding ApplyPresetCommand}"
                                    Background="{DynamicResource Button.AccentBg}" BorderBrush="{DynamicResource Button.AccentBorder}" Foreground="{DynamicResource Text.Primary}"/>
                            <Button Content="删除" Width="64" Margin="0,0,14,0" Padding="0,4"
                                    Command="{Binding DeletePresetCommand}"
                                    Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Border.Card}" Foreground="{DynamicResource Text.Primary}"/>
                            <TextBlock Text="另存为" FontSize="12" Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="110" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                     Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="保存当前装扮" Width="100" Padding="0,4"
                                    Command="{Binding SavePresetCommand}"
                                    Background="{DynamicResource Button.AccentBg}" BorderBrush="{DynamicResource Button.AccentBorder}" Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
