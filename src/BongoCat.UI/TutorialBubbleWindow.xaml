<Window x:Class="BongoCat.UI.TutorialBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咚咚窝 · 新手教程"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <!--
      E7 教程气泡（GDD-07 §4 教程覆盖层；epics E7-S1）：
      小卡片跟随目标位置（步 0/1 指向猫、步 2 指向托盘方向），非模态不阻塞其他功能。
      AllowsTransparency + Background=Transparent：只有卡片本体可点击，气泡外不挡任何操作。
      ShowActivated=False：不抢玩家游戏焦点（与桌宠"绝不激活"同一体验纪律）。
      配色全部走主题键 DynamicResource（E7 主题热切换对教程窗口同样生效）。
    -->

    <Border x:Name="Card" Background="{DynamicResource Bg.Card}"
            BorderBrush="{DynamicResource Border.Card}" BorderThickness="2"
            CornerRadius="12" Padding="14,10" Width="248">
        <StackPanel>
            <TextBlock x:Name="StepTitle" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource Text.Primary}"/>
            <TextBlock x:Name="StepBody" FontSize="12" Margin="0,4,0,10"
                       TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 步 2 专属直达：打开背包（经回调路由托盘命令 → InventoryRequested 事件即完成步 2）。
                     按钮回调由 code-behind 构造函数接线（Click 转发 App 层回调，见 TutorialBubbleWindow.xaml.cs） -->
                <Button x:Name="OpenBagButton" Content="打开背包" Width="76" Padding="0,4"
                        Margin="0,0,6,0" FontSize="12" Visibility="Collapsed"
                        Background="{DynamicResource Button.AccentBg}"
                        BorderBrush="{DynamicResource Button.AccentBorder}"
                        Foreground="{DynamicResource Text.Primary}"/>
                <Button x:Name="NextButton" Content="下一步" Width="64" Padding="0,4"
                        Margin="0,0,6,0" FontSize="12"
                        Background="{DynamicResource Button.AccentBg}"
                        BorderBrush="{DynamicResource Button.AccentBorder}"
                        Foreground="{DynamicResource Text.Primary}"/>
                <Button x:Name="SkipButton" Content="跳过教程" Width="76" Padding="0,4" FontSize="12"
                        Background="{DynamicResource Bg.Window}"
                        BorderBrush="{DynamicResource Border.Card}"
                        Foreground="{DynamicResource Text.Secondary}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
