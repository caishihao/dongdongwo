<Window x:Class="BongoCat.UI.RemoteCatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咚咚窝 · 远端伙伴"
        Width="110" Height="100"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent">

    <!--
      远程猫窗口（E8；GDD-08 风格同步追加）：
      1. 主猫 8 层部件预算（ADR-003）不被挤占；窗口数 = 在线好友数 ≤ 7，WPF 多透明窗在此量级无压力；
      2. 独立窗口可各自 SetWindowScreenPos 移动，与主猫拖动逻辑零耦合。
      点击穿透：WS_EX_TRANSPARENT（code-behind 注入），远程猫不响应任何鼠标输入。
      GDD-08 渲染：猫本体由 StyleRenderer 装载（与主猫同一渲染器/同一份 6 风格模板，
      单一数据源；远端 style 字节到达时整体重载模板并保留已收到的装扮）。窗口保持
      固定 110×100（240×200 画布等比缩放）：Q版 hat 锚点上移量（-10px）经验证全部
      帽子剪影仍在画布内（最上元素 y≥2），无需自适应高度（开放问题②结论，见烟测文档）。
      敲击动画：CatTapAnimator 风格参数化（只动 RenderTransform，ADR-003 纪律）。
    -->

    <Grid>
        <Viewbox Stretch="Uniform" Margin="4,18,4,2">
            <Canvas x:Name="CatCanvas" Width="240" Height="200" Background="Transparent">
                <!-- 风格模板根画布：由 StyleRenderer.ApplyStyle 装载（与主猫同模板同部件契约） -->
                <Canvas x:Name="StyleHost" Width="240" Height="200" Background="Transparent"/>
            </Canvas>
        </Viewbox>

        <!-- 名字牌（E9：宠物头顶上方，半透明主题色，字号 11，超长省略） -->
        <Border x:Name="NamePlate" VerticalAlignment="Top" HorizontalAlignment="Center"
                MaxWidth="104" Margin="6,2,6,0" CornerRadius="6" Opacity="0.86"
                Background="{DynamicResource Bg.Card}"
                BorderBrush="{DynamicResource Border.Card}" BorderThickness="1"
                Padding="6,1">
            <TextBlock x:Name="NameText" Foreground="{DynamicResource Text.Primary}" FontSize="11"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
        </Border>
    </Grid>
</Window>
