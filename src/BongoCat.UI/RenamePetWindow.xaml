<Window x:Class="BongoCat.UI.RenamePetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="咚咚窝 · 给伙伴改名"
        Width="360" Height="210"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}">

    <!--
      E9 重命名小对话框：与 StylePicker/背包共用主题键（DynamicResource），
      输入规则与首登一致（trim / 控制符 / 12 字素 / UTF-8 ≤24 字节；
      最终清洗在 TrayCommandController.SetPetName，单一写入路径）。
    -->

    <StackPanel Margin="18,16">
        <TextBlock Text="给你的伙伴取个名字" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource Text.Primary}"/>
        <TextBlock Text="最多 12 个字（表情按 1 个字算）；留空恢复物种默认名。"
                   FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Secondary}"/>

        <TextBox x:Name="PetNameBox" MaxLength="24" Padding="8,6" FontSize="14"
                 Background="{DynamicResource Bg.Card}"
                 Foreground="{DynamicResource Text.Primary}"
                 BorderBrush="{DynamicResource Border.Card}"
                 ToolTip="例如：布丁、糯米团、阿瓜二世"/>

        <TextBlock x:Name="HintText" Text="" FontSize="11" Margin="0,6,0,0"
                   Foreground="{DynamicResource Text.Secondary}"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="取消" Padding="0,7" IsCancel="True"
                    Background="{DynamicResource Bg.Card}"
                    BorderBrush="{DynamicResource Border.Card}"
                    Foreground="{DynamicResource Text.Secondary}"/>
            <Button Grid.Column="2" Content="保存" Padding="0,7" IsDefault="True"
                    Background="{DynamicResource Button.AccentBg}"
                    BorderBrush="{DynamicResource Button.AccentBorder}"
                    Foreground="{DynamicResource Text.Primary}"
                    Click="OnConfirm"/>
        </Grid>
    </StackPanel>
</Window>
